# systemd unit for running the server directly on a VPS, without Docker.
#
#   sudo cp server/deploy/storystation.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now storystation
#   journalctl -u storystation -f

[Unit]
Description=Story Station sync server
Documentation=https://github.com/smoottooms-ux/theopq
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=storystation
Group=storystation
WorkingDirectory=/opt/storystation/server

Environment=NODE_ENV=production
Environment=DATA_DIR=/var/lib/storystation
Environment=TRUST_PROXY_HOPS=1
EnvironmentFile=/etc/storystation/env

ExecStart=/usr/bin/node dist/index.js

# The process drains in-flight requests and checkpoints SQLite on SIGTERM.
KillSignal=SIGTERM
TimeoutStopSec=30
Restart=always
RestartSec=5

# It only ever needs to read its own code and write its data directory.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/storystation
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=storystation

[Install]
WantedBy=multi-user.target
