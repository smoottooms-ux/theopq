node_modules/
dist/
*.log
.DS_Store
.env
.env.*

# Server runtime state
server/data/
server/dist/

# Android build output
app/android/.gradle/
app/android/build/
app/android/app/build/
app/android/local.properties
app/android/captures/
app/android/.idea/
*.keystore
*.jks
# ...except the fixed debug key. It is not a secret (password "android") and
# signs debug builds only. It is committed so every build shares one
# signature, which is what lets a new APK install over the old one instead of
# forcing an uninstall that wipes the parent's recordings.
!app/android/keystore/storystation-debug.keystore

# Capacitor copies the built bundle in; CI regenerates it
app/android/app/src/main/assets/public/

# Scratch
*.tmp.mjs
